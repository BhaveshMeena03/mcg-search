# Copy to .env and fill in. The Voyage and Pinecone accounts are shared
# with the Market Bubble project, so usage from here lands on the same
# bill.

# Only needed to talk to api.anthropic.com DIRECTLY. Leave it unset when
# routing through a proxy — usepod authenticates on the token in its URL
# and ignores this, so a real key here would sit in the file for nothing.
#ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...
PINECONE_API_KEY=pcsk_...

# MCG's OWN index. scripts/ingest_episodes.py refuses to run if this is set
# to bullpen-concierge, which is the live Market Bubble index.
PINECONE_INDEX=mcg-search
PINECONE_NAMESPACE=mcg

# Optional. Route Anthropic calls through a proxy without a code change:
#   ANTHROPIC_BASE_URL=https://api.usepod.ai/proxy/<token>
# ANTHROPIC_BASE_URL=

# Only needed on a free Voyage key (3 requests/minute). Leave at 0 on paid.
# VOYAGE_REQUEST_GAP_SECONDS=0
